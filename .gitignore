# macOS
.DS_Store
build/
build-release/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# XcodeGen tarafından üretilen proje depoya işlenir,
# ancak kullanıcıya özel dosyalar (xcuserdata) yukarıda ignore edilir.
*.xcodeproj/project.xcworkspace/xcuserdata/

# Gizli bilgiler (API anahtarları vb. asla depoya girmez)
.env
.env.*
*.key
secrets.json

# Uygulama çalışma alanı / model dosyaları
# Not: "models/" yazılırsa core.ignorecase=true yüzünden VideoAsistan/Models/
# kaynak klasörünü de yok sayar; bu yüzden kök dizine sabitlenmiştir.
VideoAsistant.work/
/models/
*.bin

# Mini App çalışma zamanı geçici dosyaları
miniapps/**/node_modules/
